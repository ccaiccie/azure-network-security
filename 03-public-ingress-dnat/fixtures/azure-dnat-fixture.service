[Unit]
Description=Azure DNAT synthetic HTTP fixture (plain HTTP on backend8080)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/azure-dnat-lab.env
ExecStart=/usr/bin/python3 -I /opt/azure-dnat-lab/server.py --bind ${BIND_IP} --port 8080 --role backend
DynamicUser=yes
WorkingDirectory=/opt/azure-dnat-lab
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
