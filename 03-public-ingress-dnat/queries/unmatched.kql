// Supplemental evidence, not a promise that every unmatched ingress has a row.
union isfuzzy=true AZFWNetworkRule, AZFWThreatIntel
| where TimeGenerated > ago(30m)
| where _ResourceId =~ "FIREWALL_RESOURCE_ID"
| where DestinationIp == "ACTUAL_FIREWALL_PUBLIC_IPV4"
| where DestinationPort in (8443, 8444)
| order by TimeGenerated asc
