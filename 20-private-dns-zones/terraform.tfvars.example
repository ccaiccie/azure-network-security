# Copy to terraform.tfvars and edit. Every gate is false and break_fix is none by default.
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "westeurope"
name_prefix     = "dns20"
zone_name       = "lab20.example"

# Gate 1: vm-app-1 and vm-spoke-1 (billable). Paste the text of your public key, not a path.
deploy_vms           = false
admin_ssh_public_key = ""

# Gate 2: dns-fwd forwarder VM, and the app VNet's DNS server setting
deploy_custom_dns = false

# Gate 3: storage account, blob private endpoint, privatelink.blob.core.windows.net zone and links
deploy_private_endpoint = false

# Gate 4: public zone with the same name as the private zone (split-horizon)
create_public_zone = false

# Break/fix selector: none | no_spoke_link | no_zone_group | pe_zone_unlinked | public_forwarder | stale_record
break_fix = "none"
