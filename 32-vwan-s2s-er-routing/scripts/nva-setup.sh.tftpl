#!/usr/bin/env bash
# Designed, not tested. Boot script (Terraform template) for vm-nva in the shared spoke.
# FRR peers (eBGP, ASN ${nva_asn}) with both virtual hub router IPs (hub ASN ${hub_asn}) and announces one prefix behind it.
# The hub router needs ebgp-multihop 2 because its IPs are not on the NVA's subnet (check current docs).
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y frr
sed -i 's/^bgpd=no/bgpd=yes/' /etc/frr/daemons
sysctl -w net.ipv4.ip_forward=1
echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/99-forward.conf

# a prefix that exists only behind the NVA (a blackhole route stands in for a real network)
ip route replace blackhole ${advertise}

cat > /etc/frr/frr.conf <<'EOF'
frr defaults traditional
hostname vm-nva
!
router bgp ${nva_asn}
 bgp router-id 10.103.0.10
 no bgp ebgp-requires-policy
%{ for ip in router_ips ~}
 neighbor ${ip} remote-as ${hub_asn}
 neighbor ${ip} ebgp-multihop 2
%{ endfor ~}
 address-family ipv4 unicast
  network ${advertise}
 exit-address-family
!
EOF
systemctl restart frr
