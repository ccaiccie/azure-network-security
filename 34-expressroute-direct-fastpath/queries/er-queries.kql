// Designed, not tested. Needs the gateway's metrics in Log Analytics (gate 7 sets up the diagnostic setting).
// Metric names can change: compare with the current Microsoft docs.

// 1. Gateway load, 15-minute bins
AzureMetrics
| where ResourceProvider == "MICROSOFT.NETWORK"
| where MetricName in ("ExpressRouteGatewayCpuUtilization", "ExpressRouteGatewayPacketsPerSecond")
| summarize avg(Average), max(Maximum) by MetricName, bin(TimeGenerated, 15m)
| order by TimeGenerated desc

// 2. Circuit availability per path (needs the circuit's metrics in the workspace)
AzureMetrics
| where MetricName in ("ArpAvailability", "BgpAvailability")
| summarize min(Minimum) by MetricName, Resource, bin(TimeGenerated, 5m)
| where min_Minimum < 100

// 3. Circuit traffic and drops
AzureMetrics
| where MetricName in ("BitsInPerSecond", "BitsOutPerSecond", "DroppedInBitsPerSecond", "DroppedOutBitsPerSecond")
| summarize max(Maximum) by MetricName, Resource, bin(TimeGenerated, 5m)
