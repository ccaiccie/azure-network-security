let gateway = "REPLACE_WITH_GUARDED_GATEWAY_ID";
let case_id = "REPLACE_WITH_CASE_UUID";
AGWAccessLogs
| where _ResourceId =~ gateway
| where TimeGenerated between (datetime(2000-01-01T00:00:00Z) .. datetime(2000-01-01T00:01:00Z))
| where UserAgent == strcat("azure-waf-lab/", case_id)
| project TimeGenerated, TransactionId, ClientIp, ClientPort, HttpStatus, ServerStatus,
          ListenerName, RuleName, BackendPoolName, BackendSettingName, ServerRouted,
          UpstreamSourcePort, SslProtocol, BackendSslProtocol, WafMode, WafPolicyId
| order by TimeGenerated asc
