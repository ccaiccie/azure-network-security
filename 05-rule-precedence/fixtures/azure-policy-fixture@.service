[Unit]
Description=Azure policy synthetic HTTP fixture on port %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/azure-policy-lab.env
ExecStart=/usr/bin/python3 -I /opt/azure-policy-lab/server.py --bind ${BIND_IP} --port %i
DynamicUser=yes
WorkingDirectory=/opt/azure-policy-lab
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
