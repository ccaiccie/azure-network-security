[Unit]
Description=Owned Route Server lab substrate, closed guest policy and deny-all BGP export
Wants=network-online.target
After=network-online.target
Before=frr.service azure-routeserver-fixture@8080.service azure-routeserver-fixture@8081.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/azure-routeserver-lab/controller.py boot
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
