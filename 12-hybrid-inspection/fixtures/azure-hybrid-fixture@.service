[Unit]
Description=Private hybrid synthetic fixture on port %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /opt/azure-hybrid-lab/server.py --port %i
DynamicUser=yes
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
# AF_NETLINK permits the startup ip -j -4 addr read; no CAP_NET_ADMIN granted.
TasksMax=96
MemoryMax=128M
LimitNOFILE=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
