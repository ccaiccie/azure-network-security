# Copy to terraform.tfvars and edit. Every gate is false by default.
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "westeurope"
name_prefix     = "nsg19"

# Gate 1: two small VMs (billable). Paste the text of your public key, not a path.
deploy_vms           = false
admin_ssh_public_key = ""

# Gate 2: NIC-level NSG on the app VM (needs deploy_vms = true)
attach_nic_nsg = false

# Gate 3: storage account + blob private endpoint + the pe subnet NSG
deploy_private_endpoint = false
pe_network_policies     = "Enabled"

# Gate 4: virtual network flow log
enable_flow_logs        = false
flow_log_retention_days = 7

# Gate 5: Virtual Network Manager security admin rule (affects every VNet in its network group)
enable_avnm_demo = false

# Activity 5: set false to remove web-1's NIC from asg-web
web_nic_in_asg = true
